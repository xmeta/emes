{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/emes/spec/emes-power-v0.schema.json",
  "title": "EMES Electrical Power Extension v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["battery_packs", "power_paths"],
  "properties": {
    "battery_packs": {
      "type": "array",
      "items": {"$ref": "#/$defs/battery_pack"}
    },
    "power_paths": {
      "type": "array",
      "items": {"$ref": "#/$defs/power_path"},
      "minItems": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "battery_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "cell_component",
        "bms_component",
        "series_parameter",
        "parallel_parameter",
        "overhead_mass"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "component": {"$ref": "#/$defs/id"},
        "cell_component": {"$ref": "#/$defs/id"},
        "bms_component": {"$ref": "#/$defs/id"},
        "series_parameter": {"$ref": "#/$defs/id"},
        "parallel_parameter": {"$ref": "#/$defs/id"},
        "overhead_mass": {"$ref": "#/$defs/quantity"}
      }
    },
    "power_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "load_case"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_pack": {"$ref": "#/$defs/id"},
        "source_component": {"$ref": "#/$defs/id"},
        "fuse_component": {"$ref": "#/$defs/id"},
        "converter_component": {"$ref": "#/$defs/id"},
        "load_case": {"$ref": "#/$defs/id"}
      },
      "oneOf": [
        {
          "required": ["source_pack", "converter_component"],
          "not": {"required": ["source_component"]}
        },
        {
          "required": ["source_component"],
          "not": {
            "anyOf": [
              {"required": ["source_pack"]},
              {"required": ["converter_component"]},
              {"required": ["fuse_component"]}
            ]
          }
        }
      ]
    }
  }
}
