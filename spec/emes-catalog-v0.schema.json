{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/emes/spec/emes-catalog-v0.schema.json",
  "title": "EMES Catalog Snapshot v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["emes_catalog_version", "catalog", "sources", "parts"],
  "properties": {
    "emes_catalog_version": {"const": "0.1"},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
    "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}, "minItems": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority", "format"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "authority": {"enum": ["manufacturer", "distributor", "aggregator", "standard", "derived", "synthetic"]},
        "format": {"enum": ["json", "csv", "xml", "etim-xchange", "ontoml", "api", "datasheet", "other"]},
        "uri": {"type": "string"},
        "path": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "license": {"type": "string"},
        "raw_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "rating_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "op", "value", "unit"],
      "properties": {
        "parameter": {"$ref": "#/$defs/id"},
        "op": {"enum": ["<", "<=", ">", ">=", "=="]},
        "value": {"type": ["number", "string", "boolean"]},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "property_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": ["number", "string", "boolean"]},
        "unit": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/id"},
        "tolerance": {"type": "number", "minimum": 0},
        "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rating_condition"}}
      }
    },
    "axis_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unit", "values"],
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 2, "items": {"type": "number"}}
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "x": {"$ref": "#/$defs/axis_data"},
        "y": {"$ref": "#/$defs/axis_data"},
        "source": {"$ref": "#/$defs/id"}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "properties"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "frame": {"type": "string"},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/property_value"}}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["step", "stp", "iges", "stl", "mesh", "drawing", "datasheet", "other"]},
        "uri": {"type": "string"},
        "path": {"type": "string"},
        "digest": {"$ref": "#/$defs/digest"},
        "source": {"$ref": "#/$defs/id"},
        "license": {"type": "string"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "code"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "release": {"type": "string"},
        "code": {"type": "string", "minLength": 1}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "identity", "properties"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["motor", "gearbox", "bearing", "sensor", "fastener", "transmission", "spring", "damper", "controller", "power_supply", "battery_cell", "battery_pack", "bms", "power_converter", "charger", "fuse", "contactor", "connector", "other"]},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manufacturer", "part_number"],
          "properties": {
            "manufacturer": {"type": "string", "minLength": 1},
            "part_number": {"type": "string", "minLength": 1},
            "gtin": {"type": "string"}
          }
        },
        "classifications": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/property_value"}},
        "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"curves": {"type": "array", "items": {"$ref": "#/$defs/curve"}}}
        },
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      }
    }
  }
}
