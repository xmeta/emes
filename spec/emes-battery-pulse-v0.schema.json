{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/emes/spec/emes-battery-pulse-v0.schema.json",
  "title": "EMES Source-Conditioned Battery Pulse Analysis v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_id", "pack_id", "power_properties", "context", "constraint"],
  "properties": {
    "analysis_id": {"$ref": "#/$defs/id"},
    "pack_id": {"$ref": "#/$defs/id"},
    "power_properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/quantity"},
      "propertyNames": {"$ref": "#/$defs/id"}
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "op": {"enum": ["<", "<=", ">", ">=", "=="]},
        "target": {"$ref": "#/$defs/quantity"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    }
  }
}
