{
  "emes_version": "0.1",
  "design": {
    "id": "DESIGN_POWER_PACK",
    "name": "Reference 21700 battery-powered DC subsystem",
    "description": "Synthetic 21700 10S2P pack, BMS and DC converter fixture for EMES power composition."
  },
  "requirements": [
    {"id": "R_BUS_VOLTAGE", "kind": "interface", "statement": "Provide a nominal 36 V DC load bus."},
    {"id": "R_ENERGY", "kind": "performance", "statement": "Provide at least 300 Wh nominal stored energy."},
    {"id": "R_CURRENT", "kind": "performance", "statement": "Supply the reference load within both pack-current and converter-power limits."},
    {"id": "R_BMS", "kind": "safety", "statement": "Use a BMS compatible with pack series count and maximum pack voltage."}
  ],
  "design_intent": [
    {
      "id": "DI_COMPOSE_CELLS",
      "statement": "Represent repeated cylindrical cells by series/parallel composition rather than duplicating cell records.",
      "protects": ["R_ENERGY", "R_BMS"]
    }
  ],
  "parameters": [
    {
      "id": "P_PACK_SERIES",
      "role": "design_variable",
      "value": {"value": 10.0, "unit": "1"},
      "lower": {"value": 1.0, "unit": "1"},
      "upper": {"value": 20.0, "unit": "1"}
    },
    {
      "id": "P_PACK_PARALLEL",
      "role": "design_variable",
      "value": {"value": 2.0, "unit": "1"},
      "lower": {"value": 1.0, "unit": "1"},
      "upper": {"value": 10.0, "unit": "1"}
    }
  ],
  "components": [
    {
      "id": "cell_model",
      "kind": "purchased_part",
      "metadata": {
        "org.emes.catalog_ref": {
          "catalog": "CAT_POWER",
