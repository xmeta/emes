      "metadata": {"org.emes.role": "battery_pack_assembly"}
    },
    {
      "id": "dc_converter",
      "kind": "purchased_part",
      "metadata": {
        "org.emes.catalog_ref": {
          "catalog": "CAT_POWER",
          "part": "DCDC_REF_25_50V_TO_36V_20A",
          "digest": "sha256:71785ddca5367b924235f7e1e9fbd8de313f0e97dc8e3e7fb03f5553929b695d"
        }
      }
    },
    {"id": "dc_bus_load", "kind": "other", "metadata": {"org.emes.role": "electrical_load"}}
  ],
  "connections": [
    {
      "id": "E_PACK_TO_CONVERTER",
      "kind": "electrical",
      "a": {"component": "battery_pack", "port": "dc_out"},
      "b": {"component": "dc_converter", "port": "IF_DC_IN"}
    },
    {
      "id": "E_CONVERTER_TO_LOAD",
      "kind": "electrical",
      "a": {"component": "dc_converter", "port": "IF_DC_OUT"},
      "b": {"component": "dc_bus_load", "port": "dc_in"}
    }
  ],
  "functional_edges": [
    {"id": "F_CELL_COMPOSES_PACK", "from": "cell_model", "relation": "repeated-series-parallel-member-of", "to": "battery_pack"},
    {"id": "F_BMS_PROTECTS_PACK", "from": "bms", "relation": "protects", "to": "battery_pack"},
    {"id": "F_PACK_POWERS_CONVERTER", "from": "battery_pack", "relation": "supplies-electrical-power-to", "to": "dc_converter"},
    {"id": "F_CONVERTER_POWERS_LOAD", "from": "dc_converter", "relation": "supplies-electrical-power-to", "to": "dc_bus_load"}
