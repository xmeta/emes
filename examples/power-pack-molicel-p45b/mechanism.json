{
  "emes_version": "0.1",
  "design": {
    "id": "DESIGN_POWER_PACK_MOLICEL_P45B",
    "name": "Molicel P45B battery-powered DC subsystem",
    "description": "Authoritative Molicel P45B 10S2P cell selection with real JKBMS BMS and manufacturer-backed SynQor NiQor NQ60 converter configured at 36 V, executable conditional-current checks, and a source-conditioned first-order voltage-drop analysis."
  },
  "requirements": [
    {"id": "R_BUS_VOLTAGE", "kind": "interface", "statement": "Provide a nominal 36 V DC load bus."},
    {"id": "R_ENERGY", "kind": "performance", "statement": "Provide at least 300 Wh nominal stored energy."},
    {"id": "R_CURRENT", "kind": "performance", "statement": "Supply the reference load with nonnegative continuous current margin."},
    {"id": "R_BMS", "kind": "safety", "statement": "Use a BMS compatible with the full modeled pack series-count and voltage ranges."}
  ],
  "design_intent": [
    {
      "id": "DI_REAL_CELL_CONDITIONS",
      "statement": "The P45B continuous-discharge rating is usable only when a selected control component satisfies every normalized manufacturer rating condition.",
      "protects": ["R_CURRENT", "R_BMS"]
    },
    {
      "id": "DI_SAG_SOURCE_CONDITION",
      "statement": "Use a P45B impedance value only at a design analysis point that satisfies the source-stated SOC condition; do not interpolate unsupported SOC values.",
      "protects": ["R_CURRENT"]
    },
    {
      "id": "DI_COMPOSE_CELLS",
      "statement": "Represent repeated cylindrical cells by series/parallel composition rather than duplicating cell records.",
      "protects": ["R_ENERGY"]
    }
  ],
  "parameters": [
    {
      "id": "P_PACK_SERIES",
      "role": "design_variable",
      "value": {"value": 10.0, "unit": "1"},
      "lower": {"value": 1.0, "unit": "1"},
      "upper": {"value": 20.0, "unit": "1"}
    },
    {
      "id": "P_PACK_PARALLEL",
      "role": "design_variable",
      "value": {"value": 2.0, "unit": "1"},
      "lower": {"value": 1.0, "unit": "1"},
      "upper": {"value": 10.0, "unit": "1"}
    },
    {
      "id": "P_SAG_SOC",
      "role": "fixed",
      "value": {"value": 50.0, "unit": "%"}
    },
    {
      "id": "P_BMS_DISCHARGE_OVERTEMP",
      "role": "fixed",
      "value": {"value": 70.0, "unit": "degC"}
    }
  ],
  "components": [
