    {"id": "E_FUSE_TO_CONVERTER", "kind": "electrical", "a": {"component": "main_fuse", "port": "IF_OUT"}, "b": {"component": "dc_converter", "port": "IF_DC_IN"}},
    {"id": "E_CONVERTER_TO_LOAD", "kind": "electrical", "a": {"component": "dc_converter", "port": "IF_DC_OUT"}, "b": {"component": "dc_bus_load", "port": "dc_in"}}
