{
  "emes_version": "0.1",
  "design": {
    "id": "DESIGN_POWER_PACK_MOLICEL_P45B_CONNECTED",
    "name": "Molicel P45B battery subsystem with fuse, contactor, and SB50 connector",
    "description": "Authoritative Molicel P45B 10S2P cell selection with real JKBMS BMS and synthetic converter fixture, reviewed Littelfuse MIDI HP fuse, Littelfuse DCNHF60NG12-F contactor, and Anderson Power Products SB50 wire-to-wire connector assembly in the pack-side power path."
  },
  "requirements": [
    {"id": "R_BUS_VOLTAGE", "kind": "interface", "statement": "Provide a nominal 36 V DC load bus."},
    {"id": "R_ENERGY", "kind": "performance", "statement": "Provide at least 300 Wh nominal stored energy."},
    {"id": "R_CURRENT", "kind": "performance", "statement": "Supply the reference load with nonnegative continuous current margin."},
    {"id": "R_BMS", "kind": "safety", "statement": "Use a BMS compatible with the full modeled pack series-count and voltage ranges."},
    {"id": "R_FUSE", "kind": "safety", "statement": "Represent a DC-rated series fuse explicitly and require its DC voltage rating to cover maximum pack voltage."},
    {"id": "R_CONTACTOR", "kind": "safety", "statement": "Represent the pack contactor explicitly and require its source-backed continuous current and DC operating-voltage range to cover the modeled pack path."},
    {"id": "R_CONNECTOR", "kind": "safety", "statement": "Represent the pack-side connector assembly explicitly, require its DC voltage rating to cover maximum pack voltage, and require its rated current to cover the reference pack current."}
  ],
  "design_intent": [
    {"id": "DI_REAL_CELL_CONDITIONS", "statement": "The P45B continuous-discharge rating is usable only when a selected control component satisfies every normalized manufacturer rating condition.", "protects": ["R_CURRENT", "R_BMS"]},
    {"id": "DI_FUSE_EXPLICIT", "statement": "Treat the fuse as a first-class power-path component; use nominal rated current only as a conservative known-limit cap and do not infer a 10-second ampacity from sparse time-current or I2t data.", "protects": ["R_CURRENT", "R_FUSE"]},
    {"id": "DI_CONTACTOR_EXPLICIT", "statement": "Treat the contactor as a first-class power-path component using only source-backed main-contact continuous current and declared DC operating-voltage range; do not infer pulse ampacity, switching life, coil-drive suitability, or pre-charge approval.", "protects": ["R_CURRENT", "R_CONTACTOR"]},
    {"id": "DI_CONNECTOR_ASSEMBLY", "statement": "Treat the connector as the reviewed mated wire-to-wire assembly configuration, not as a bare housing, and include its native current rating in weakest-link evaluation.", "protects": ["R_CURRENT", "R_CONNECTOR"]},
    {"id": "DI_COMPOSE_CELLS", "statement": "Represent repeated cylindrical cells by series/parallel composition rather than duplicating cell records.", "protects": ["R_ENERGY"]}
  ],
  "parameters": [
    {"id": "P_PACK_SERIES", "role": "design_variable", "value": {"value": 10.0, "unit": "1"}, "lower": {"value": 1.0, "unit": "1"}, "upper": {"value": 20.0, "unit": "1"}},
    {"id": "P_PACK_PARALLEL", "role": "design_variable", "value": {"value": 2.0, "unit": "1"}, "lower": {"value": 1.0, "unit": "1"}, "upper": {"value": 10.0, "unit": "1"}},
    {"id": "P_BMS_DISCHARGE_OVERTEMP", "role": "fixed", "value": {"value": 70.0, "unit": "degC"}}
  ],
